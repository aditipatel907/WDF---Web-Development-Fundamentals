/* General */
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f2f5f8;
}


/* Header */
header {
    background-color: #00006b;
    color: white;
    padding: 20px;
    text-align: center;
}

header h1 {
    margin: 5px;
}

nav {
    display: flex;
    justify-content: center;
    gap: 25px;
    margin-top: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    padding: 10px 15px;
    border-radius: 5px;
}

nav a:hover {
    background-color:#fafafa;
    color: #00006b;
}


/* Sections */
section {
    padding: 25px;
}

h2 {
    text-align: center;
    color: #174a7e;
}


/* Event Cards */
.event-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.event-card {
    background-color: white;
    width: 250px;
    min-height: 250px;
    padding: 20px;
    border: 2px solid;
    border-radius: 10px;
    margin: 10px;
}

.event-card h3 {
    color: #174a7e;
}

.event-card:hover {
    background-color: #e8f2ff;
}


/* Buttons */
button {
    border: none;
    padding: 10px 15px;
    cursor: pointer;
}

button:hover {
    background-color: #0d3155;
}


/* Registration Form */
form {
    display: flex;
    flex-direction: column;
    width: 500px;
    margin: auto;
    padding: 25px;
    background-color: white;
    border: 2px solid;
    border-radius: 10px;
}

form label {
    margin-top: 10px;
    margin-bottom: 5px;
    font-weight: bold;
}

input,
select {
    padding: 10px;
    border: 1px solid;
    border-radius: 5px;
}

.gender {
    display: flex;
    gap: 10px;
    margin: 10px 0;
}

.form-buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
}


/* FAQ */
.faq-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.faq-item {
    background-color: white;
    width: 400px;
    padding: 15px;
    border: 2px solid #174a7e;
    border-radius: 8px;
}

.faq-item h3 {
    color: #174a7e;
}

.faq-item p {
    padding: 10px;
    border-radius: 5px;
}


footer {
    background-color: #174a7e;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
}
